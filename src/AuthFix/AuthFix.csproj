<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthFix</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>authfix</ToolCommandName>
    <PackageId>AuthFix</PackageId>
    <Version>0.1.0</Version>
    <Description>Remediação de falhas de autorização em APIs ASP.NET Core (CWE-862/863).</Description>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Regras/*.yml" />
  </ItemGroup>
</Project>
